# FinAnt — example environment.
# Copy to .env for LOCAL DEVELOPMENT ONLY. Never commit .env.
#
# The shipped app does NOT read these. At runtime the user enters their own
# GoCardless credentials in Settings and they are stored in the device
# Keychain (iOS) / Keystore (Android) — never in the binary, never in a file.
# These vars exist only so dev scripts and integration tests can talk to the
# GoCardless sandbox from a laptop.

# GoCardless Bank Account Data (ex-Nordigen) — https://bankaccountdata.gocardless.com/
GOCARDLESS_SECRET_ID=changeme
GOCARDLESS_SECRET_KEY=changeme

# Sandbox institution id used by integration tests (no real bank involved).
GOCARDLESS_TEST_INSTITUTION_ID=SANDBOXFINANCE_SFIN0000
